{
  "name": "dungeon-crew",
  "version": "1.0.0",
  "description": "Co-op multiplayer browser dungeon crawler",
  "main": "server/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test --test-timeout=20000 test/*.test.js",
    "sprites": "node tools/make-sprites.js",
    "cloud:dev": "wrangler dev",
    "cloud:deploy": "wrangler deploy",
    "build:web": "node tools/build-web.js"
  },
  "dependencies": {
    "express": "^4.22.3",
    "phaser": "^3.90.0",
    "ws": "^8.23.0"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "devDependencies": {
    "wrangler": "^4.166.0"
  }
}
